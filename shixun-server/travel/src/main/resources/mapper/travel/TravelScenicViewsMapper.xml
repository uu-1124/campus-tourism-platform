<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pz.travel.mapper.TravelScenicViewsMapper">
    <insert id="insertScenicViews">
        insert into travel_scenic_view
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="scenicId != null">scenic_id,</if>
            <if test="dates != null">dates,</if>
            <if test="eventType != null">event_type,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="sourceDetail != null and sourceDetail != ''">source_detail,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="scenicId !=null">#{scenicId},</if>
            <if test="dates != null">#{dates},</if>
            <if test="eventType != null">#{eventType},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="sourceDetail != null and sourceDetail != ''">#{sourceDetail},</if>
        </trim>
    </insert>
</mapper>
