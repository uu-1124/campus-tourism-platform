# 数据源配置（复制本文件为 application-dev.yml 并填写真实密钥）
spring:
  datasource:
    druid:
      # 主库数据源
      master:
        url: jdbc:mysql://127.0.0.1:3306/read_building?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&serverTimezone=GMT%2B8&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true
        username: root
        password: <your-mysql-password>
  # redis 配置
  redis:
    # 地址
    host: 127.0.0.1
    # 端口
    port: 6380
    # 密码
    # password:
    database: 1
# 微信小程序相关配置
wx:
  miniapp:
    configs:
      - appid: <your-wx-miniapp-appid>
        secret: <your-wx-miniapp-secret>
        token: <your-wx-token>
        aesKey: <your-wx-aes-key>
        msgDataFormat: JSON
  mp:
    useRedis: true
    configs:
      - appId: <your-mp-appid>
        secret: <your-mp-appsecret>
        token: test
        aesKey: test
  pay:
    configs:
      - appId: <your-pay-appid>
        mchId: <your-mch-id>
        mchKey: <your-mch-key>
        subAppId:
        subMchId:
        keyPath:
      - appId: <your-pay-appid-2>
        mchId: <your-mch-id>
        mchKey: <your-mch-key>
        subAppId:
        subMchId:
        keyPath:
# 百度图片搜索
baidu:
  app-id: <your-baidu-app-id>
  api-key: <your-baidu-api-key>
  secret-key: <your-baidu-secret-key>
travel:
  path: dev/data/xuhui_travel
  vrUrl: http://127.0.0.1:5501/tour.html
  wx:
    mock-login:
      enabled: true
      open-id: local-dev-openid
      session-key: local-dev-session-key
  appointment:
