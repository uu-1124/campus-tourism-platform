.videos-page{min-height:100vh;padding-bottom:calc(50rpx + env(safe-area-inset-bottom));background:#f5f6f5;color:#222a26}.player{display:block;width:100%;height:430rpx;background:#111}.video-copy{padding:27rpx 30rpx;background:#fff}.video-copy text{display:block}.video-copy text:first-child{font-size:34rpx;font-weight:700;line-height:1.4}.video-copy text:last-child{margin-top:8rpx;color:#78817d;font-size:23rpx;line-height:1.55}.list-heading{padding:42rpx 28rpx 20rpx;font-size:31rpx;font-weight:700}.video-list{padding:0 24rpx}.video-item{display:flex;min-height:150rpx;margin-bottom:18rpx;padding:13rpx;background:#fff;border:1rpx solid transparent}.video-item.active{border-color:#cda64e}.video-item image{width:210rpx;height:132rpx;margin-right:20rpx;background:#e0e4e2}.video-item view{display:flex;min-width:0;flex:1;flex-direction:column;justify-content:center}.video-item text{display:block;overflow:hidden;text-overflow:ellipsis}.video-item text:first-child{font-size:27rpx;font-weight:600;white-space:nowrap}.video-item text:last-child{margin-top:10rpx;color:#8a928e;font-size:21rpx;line-height:1.45}.empty{padding:180rpx 30rpx;text-align:center;color:#7b8681;font-size:26rpx}.retry{color:#236b55}
