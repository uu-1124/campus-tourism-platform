.home{min-height:100vh;padding-bottom:calc(26rpx + env(safe-area-inset-bottom));background:#fff;color:#262c29}.hero{width:100%;height:420rpx;overflow:hidden;background:#e1e6e3}.hero-swiper,.hero-image{display:block;width:100%;height:100%}.recommendation{display:flex;min-height:92rpx;align-items:center;padding:0 28rpx;border-bottom:1rpx solid #edf0ee;box-sizing:border-box}.recommend-label{flex-shrink:0;font-size:27rpx;font-weight:700}.recommend-topic{max-width:330rpx;margin-left:18rpx;padding:6rpx 14rpx;overflow:hidden;border:1rpx solid #e0e2e1;color:#707873;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.section-link{margin-left:auto;color:#999f9c;font-size:22rpx;white-space:nowrap}.section{padding-right:28rpx;padding-left:28rpx}.hot-section{padding-top:34rpx}.section-heading{display:flex;min-height:48rpx;align-items:center;margin-bottom:20rpx}.section-name{font-size:31rpx;font-weight:700}.video-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24rpx}.video-card{min-width:0}.video-cover{position:relative;width:100%;height:198rpx;overflow:hidden;background:#e4e8e6}.video-cover image{display:block;width:100%;height:100%}.play-icon{position:absolute;right:13rpx;bottom:13rpx;display:flex;width:46rpx;height:46rpx;align-items:center;justify-content:center;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:18rpx;text-indent:2rpx}.video-title,.video-subtitle{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.video-title{margin-top:14rpx;font-size:25rpx;font-weight:600}.video-subtitle{margin-top:6rpx;color:#989e9b;font-size:19rpx}.building-section{padding-top:42rpx}.building-feature{position:relative;width:100%;height:320rpx;overflow:hidden;background:#e2e7e4}.building-feature image{display:block;width:100%;height:100%}.building-copy{position:absolute;right:0;bottom:0;left:0;padding:50rpx 23rpx 20rpx;background:linear-gradient(180deg,transparent,rgba(17,25,21,.72));color:#fff}.building-copy text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.building-copy text:first-child{font-size:29rpx;font-weight:600}.building-copy text:last-child{margin-top:5rpx;font-size:17rpx;opacity:.82}.quick-nav{display:flex;margin:42rpx 28rpx 0;border-top:1rpx solid #ecefed;border-bottom:1rpx solid #ecefed}.quick-nav button{flex:1;display:flex;height:138rpx;min-width:0;align-items:center;justify-content:center;flex-direction:column;margin:0;padding:0;border-radius:0;background:#fff;color:#525c57;font-size:20rpx;line-height:1.3;white-space:nowrap}.quick-nav button+button{border-left:1rpx solid #f0f2f1}.quick-icon{display:flex;height:42rpx;align-items:center;justify-content:center;margin-bottom:12rpx;color:#226951;font-size:27rpx;font-weight:600}.quick-nav button:last-child .quick-icon{font-size:17rpx}.empty{padding:48rpx 0;text-align:center;color:#929995;font-size:23rpx}.footer{display:flex;align-items:center;flex-direction:column;padding:52rpx 20rpx 15rpx;color:#9ca29f}.footer text:first-child{font-family:"Songti SC",STSong,serif;font-size:23rpx}.footer text:last-child{margin-top:6rpx;font-size:14rpx;letter-spacing:0}
