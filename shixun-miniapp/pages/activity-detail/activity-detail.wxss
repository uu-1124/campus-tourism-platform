.activity-detail{min-height:100vh;padding-bottom:calc(60rpx + env(safe-area-inset-bottom));background:#fff}.hero{display:block;width:100%;min-height:440rpx;background:#e1e8e4}.article{padding:34rpx 34rpx 60rpx}.article-meta{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.state{flex:0 0 auto;padding:7rpx 15rpx;border-radius:4rpx;background:#e9f4ef;color:#17664e;font-size:21rpx}.date{min-width:0;color:#7a8781;font-size:22rpx;text-align:right}.title{margin-top:22rpx;color:#16221e;font-size:43rpx;font-weight:700;line-height:1.3;overflow-wrap:break-word}.subtitle{margin-top:10rpx;color:#66736e;font-size:25rpx;line-height:1.6}.divider{height:1rpx;margin:30rpx 0;background:#e4e9e6}.body{display:block;color:#3e4945;font-size:28rpx;line-height:1.9;overflow:hidden}.empty-state{display:flex;min-height:80vh;flex-direction:column;align-items:center;justify-content:center;padding:50rpx;color:#83908a;font-size:27rpx}.empty-state button{width:230rpx;margin-top:28rpx;border-radius:5rpx;background:#0c654d;color:#fff;font-size:25rpx}

