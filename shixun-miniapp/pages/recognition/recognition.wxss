/* ============ 拍照识建筑 · 七彩流光风 ============ */
.page.recognition {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f8ff 0%, #f3effc 48%, #fff4ec 100%);
  padding: 0 32rpx 70rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ---------- 背景彩色光斑（缓慢漂移） ---------- */
.bg-decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(56rpx);
  opacity: .6;
}
.blob-a {
  width: 430rpx; height: 430rpx;
  background: #ffd6e8;
  top: -130rpx; right: -120rpx;
  animation: bga 14s ease-in-out infinite;
}
.blob-b {
  width: 300rpx; height: 300rpx;
  background: #d7f3dd;
  bottom: 240rpx; left: -110rpx;
  animation: bgb 17s ease-in-out infinite;
}
.blob-c {
  width: 220rpx; height: 220rpx;
  background: #dbe4ff;
  top: 540rpx; right: -70rpx;
  opacity: .5;
  animation: bgc 19s ease-in-out infinite;
}
@keyframes bga { 50% { transform: translate(-40rpx, 50rpx) scale(1.12); } }
@keyframes bgb { 50% { transform: translate(46rpx, -36rpx) scale(1.18); } }
@keyframes bgc { 50% { transform: translate(-52rpx, -30rpx) scale(.9); } }

/* ---------- 页面头部 ---------- */
.page-head {
  position: relative;
  padding: 42rpx 6rpx 30rpx;
}
.head-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7ab8, #a78bfa 55%, #60a5fa);
  padding: 8rpx 22rpx;
  border-radius: 32rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(167, 139, 250, .35);
}
.head-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1e1b3a;
  margin-top: 20rpx;
  letter-spacing: 2rpx;
}
.head-sub {
  font-size: 24rpx;
  color: #6f6a8e;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* ---------- 取景面板：彩色流体交织流转 ---------- */
.camera-panel {
  position: relative;
  height: 720rpx;
  border-radius: 44rpx;
  background: #150b36;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(60, 32, 110, .32);
  border: 1rpx solid rgba(255, 255, 255, .18);
}

/* 极光流体：两层大色斑反向旋转，颜色相互交织流动 */
.aurora {
  position: absolute;
  width: 280%;
  height: 280%;
  left: -90%;
  top: -90%;
  border-radius: 50%;
  pointer-events: none;
}
.aurora-a {
  background:
    radial-gradient(38% 42% at 22% 28%, rgba(255, 95, 109, .85), transparent 70%),
    radial-gradient(36% 44% at 72% 20%, rgba(255, 159, 67, .85), transparent 70%),
    radial-gradient(40% 46% at 52% 40%, rgba(255, 217, 61, .85), transparent 70%),
    radial-gradient(38% 42% at 26% 66%, rgba(92, 225, 122, .85), transparent 70%),
    radial-gradient(36% 44% at 78% 58%, rgba(45, 212, 191, .85), transparent 70%),
    radial-gradient(40% 46% at 50% 76%, rgba(77, 210, 255, .9), transparent 70%),
    radial-gradient(38% 42% at 74% 84%, rgba(108, 123, 255, .9), transparent 70%);
  animation: aflow 16s ease-in-out infinite;
}
.aurora-b {
  background:
    radial-gradient(36% 44% at 62% 62%, rgba(214, 117, 255, .85), transparent 70%),
    radial-gradient(38% 42% at 18% 80%, rgba(255, 107, 129, .8), transparent 70%),
    radial-gradient(36% 44% at 84% 34%, rgba(77, 210, 255, .8), transparent 70%),
    radial-gradient(40% 46% at 40% 18%, rgba(255, 159, 67, .8), transparent 70%),
    radial-gradient(38% 42% at 8% 46%, rgba(255, 217, 61, .8), transparent 70%),
    radial-gradient(36% 44% at 58% 88%, rgba(92, 225, 122, .8), transparent 70%);
  animation: bflow 22s ease-in-out infinite reverse;
}
@keyframes aflow {
  0%, 100% { transform: rotate(0deg) scale(1); }
  33%      { transform: rotate(16deg) scale(1.12); }
  66%      { transform: rotate(-12deg) scale(.92); }
}
@keyframes bflow {
  0%, 100% { transform: rotate(0deg) scale(1); }
  33%      { transform: rotate(-18deg) scale(1.08); }
  66%      { transform: rotate(13deg) scale(.9); }
}

/* 彩虹扫描线 */
.scan-line {
  position: absolute;
  left: 4%;
  right: 4%;
  top: 8%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #ff5f6d, #ffb347, #ffe066, #5ce17a, #4dd2ff, #6c7bff, #d675ff, transparent);
  box-shadow: 0 0 28rpx rgba(255, 224, 102, .95);
  animation: scanmove 3.6s ease-in-out infinite;
  z-index: 3;
}
@keyframes scanmove {
  0%   { top: 8%;  opacity: .25; }
  12%  { opacity: 1; }
  50%  { top: 90%; opacity: 1; }
  62%  { opacity: .25; }
  100% { top: 8%;  opacity: .25; }
}

/* 四色发光圆角角标 */
.corners view {
  position: absolute;
  width: 76rpx;
  height: 76rpx;
  z-index: 2;
}
.corners view:nth-child(1) {
  left: 34rpx; top: 34rpx;
  border-left: 6rpx solid #ff6b81;
  border-top: 6rpx solid #ff6b81;
  border-top-left-radius: 26rpx;
  box-shadow: -3rpx -3rpx 14rpx rgba(255, 107, 129, .65);
}
.corners view:nth-child(2) {
  right: 34rpx; top: 34rpx;
  border-right: 6rpx solid #ffd93d;
  border-top: 6rpx solid #ffd93d;
  border-top-right-radius: 26rpx;
  box-shadow: 3rpx -3rpx 14rpx rgba(255, 217, 61, .65);
}
.corners view:nth-child(3) {
  left: 34rpx; bottom: 34rpx;
  border-left: 6rpx solid #6cffb0;
  border-bottom: 6rpx solid #6cffb0;
  border-bottom-left-radius: 26rpx;
  box-shadow: -3rpx 3rpx 14rpx rgba(108, 255, 176, .65);
}
.corners view:nth-child(4) {
  right: 34rpx; bottom: 34rpx;
  border-right: 6rpx solid #7aa2ff;
  border-bottom: 6rpx solid #7aa2ff;
  border-bottom-right-radius: 26rpx;
  box-shadow: 3rpx 3rpx 14rpx rgba(122, 162, 255, .65);
}

/* 已选照片预览 */
.photo-view {
  width: 100%;
  height: 100%;
  opacity: .94;
}

/* ---------- 空态引导（流动背景之上） ---------- */
.camera-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  position: relative;
  z-index: 2;
}

/* 空态引导卡片（彩色呼吸发光） */
.lens {
  width: 150rpx;
  height: 150rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, .12);
  border: 1rpx solid rgba(255, 255, 255, .35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 86rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 2;
  animation: lensglow 2.4s ease-in-out infinite;
  box-shadow: 0 0 30rpx rgba(167, 139, 250, .55);
}
@keyframes lensglow {
  0%, 100% { box-shadow: 0 0 26rpx rgba(255, 107, 129, .5);  transform: scale(1); }
  33%      { box-shadow: 0 0 44rpx rgba(108, 255, 176, .65); transform: scale(1.04); }
  66%      { box-shadow: 0 0 44rpx rgba(122, 162, 255, .65); transform: scale(1.04); }
}
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 2;
  text-shadow: 0 2rpx 14rpx rgba(30, 10, 60, .45);
}
.empty-sub {
  font-size: 22rpx;
  opacity: .92;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
  text-shadow: 0 2rpx 12rpx rgba(30, 10, 60, .45);
}

/* ---------- 识别中遮罩（四色旋转环） ---------- */
.recognizing {
  position: absolute;
  inset: 0;
  background: rgba(24, 12, 48, .72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #f3f0ff;
  font-size: 27rpx;
  letter-spacing: 1rpx;
  z-index: 4;
}
.loading-ring {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, .14);
  border-top-color: #ff6b81;
  border-right-color: #ffe066;
  border-bottom-color: #5ce17a;
  border-left-color: #6c7bff;
  animation: spin 1s linear infinite;
  box-shadow: 0 0 36rpx rgba(167, 139, 250, .55);
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- 操作按钮 ---------- */
.actions {
  position: relative;
  margin-top: 46rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.btn {
  height: 100rpx;
  border-radius: 52rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 100rpx;
  letter-spacing: 2rpx;
  border: none;
  margin: 0;
  padding: 0;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #f97316, #ec4899 45%, #8b5cf6);
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(236, 72, 153, .38);
}
.btn-primary[disabled] { opacity: .55; box-shadow: none; }
.btn-ghost {
  background: rgba(255, 255, 255, .9);
  color: #8b5cf6;
  border: 2rpx solid rgba(139, 92, 246, .42);
  box-shadow: 0 10rpx 24rpx rgba(139, 92, 246, .12);
}
.btn-ghost[disabled] { opacity: .6; }

/* ---------- 底部提示 ---------- */
.foot-note {
  position: relative;
  text-align: center;
  font-size: 21rpx;
  color: #9b96b8;
  margin-top: 38rpx;
  letter-spacing: 1rpx;
}
