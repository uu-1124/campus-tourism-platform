.vr-intro{min-height:100vh;padding-bottom:calc(60rpx + env(safe-area-inset-bottom));background:#f4f7f6;color:#253631}.cover{display:block;width:100%;height:500rpx;background:#dfe6e3}.intro-body{margin:-42rpx 28rpx 0;padding:40rpx 34rpx 46rpx;position:relative;background:#fff;box-shadow:0 9rpx 30rpx rgba(30,48,43,.07)}.eyebrow,.title,.english,.description,.availability text{display:block}.eyebrow{color:#aa8844;font-size:18rpx}.title{margin-top:13rpx;font-size:40rpx;font-weight:650;line-height:1.35}.english{margin-top:9rpx;color:#8c9691;font-size:22rpx;line-height:1.45}.divider{height:1rpx;margin:30rpx 0;background:#e8ecea}.description{color:#53615b;font-size:26rpx;line-height:1.85}.availability{margin-top:30rpx;padding:23rpx 25rpx;background:#f4f5f4;color:#7c8581;font-size:24rpx}.availability.available{background:#edf6f1;color:#397459}.primary,.secondary{height:88rpx;margin-top:30rpx;border-radius:4rpx;font-size:27rpx;line-height:88rpx}.primary{background:#176c51;color:#fff}.secondary{background:#eef1ef;color:#53605a}.empty{padding:160rpx 30rpx;text-align:center;color:#68766f}.empty text{display:block}.empty button{width:230rpx;margin-top:30rpx;background:#176c51;color:#fff}
