.activities{min-height:100vh;padding:42rpx 28rpx calc(54rpx + env(safe-area-inset-bottom));box-sizing:border-box}.recommend-heading{display:flex;align-items:flex-end;justify-content:space-between;margin:0 2rpx 28rpx}.recommend-heading text:first-child{font-size:46rpx;font-weight:700;color:#17221f}.recommend-heading text:last-child{padding-bottom:6rpx;color:#75827b;font-size:22rpx}.modes{display:flex;gap:8rpx;margin-bottom:28rpx;border-bottom:1rpx solid #d9e3dd}.modes button{margin:0;padding:0 26rpx;background:transparent;border-radius:0;color:#75827b;font-size:27rpx;line-height:76rpx}.modes .active{border-bottom:4rpx solid #0c654d;color:#0c654d;font-weight:600}.activity{overflow:hidden;margin-bottom:34rpx;background:#fff;border:1rpx solid #e2e8e5;border-radius:8rpx;box-shadow:0 12rpx 28rpx rgba(24,46,37,.09)}.activity image{display:block;width:100%;height:600rpx;background:#e0e8e4}.activity-body{display:flex;min-height:112rpx;align-items:center;padding:20rpx 24rpx;box-sizing:border-box}.activity-body>view{min-width:0;flex:1}.activity-body text{display:block}.name{font-size:32rpx;font-weight:650;overflow-wrap:break-word}.status{margin-top:8rpx;color:#17664e;font-size:21rpx}.date{margin-top:6rpx;color:#748079;font-size:22rpx}.activity-arrow{flex:0 0 auto;padding-left:18rpx;color:#718079;font-size:45rpx}.empty{padding:110rpx 0}
