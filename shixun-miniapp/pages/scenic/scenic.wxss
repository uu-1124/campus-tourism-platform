.scenic-page{min-height:100vh;box-sizing:border-box;padding:22rpx 18rpx calc(40rpx + env(safe-area-inset-bottom));background:#f8f8fa;color:#202523}.search-row{display:flex;align-items:center;gap:18rpx}.search-box{display:flex;height:76rpx;min-width:0;flex:1;align-items:center;padding:0 22rpx;border-radius:38rpx;background:#f0f0f1;box-sizing:border-box}.search-box text{margin-right:12rpx;color:#c4487d;font-size:30rpx}.search-box input{min-width:0;flex:1;color:#333;font-size:25rpx}.search-row button{width:126rpx;height:76rpx;margin:0;border-radius:38rpx;background:#d5ac55;color:#fff;font-size:27rpx;line-height:76rpx}.filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14rpx;margin:27rpx 0 34rpx}.filters view{height:60rpx;overflow:hidden;border-radius:30rpx;background:#f0f0f1;color:#646864;font-size:25rpx;line-height:60rpx;text-align:center;white-space:nowrap}.filters view.active{background:#d5ac55;color:#fff}.masonry{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx}.column{min-width:0}.building-card{min-width:0;margin-bottom:20rpx;overflow:hidden;background:#fff;box-shadow:0 7rpx 24rpx rgba(44,50,47,.06)}.building-card image{display:block;width:100%;background:#e1e5e3}.building-card image.short{height:228rpx}.building-card image.tall{height:344rpx}.card-copy{padding:18rpx 19rpx 22rpx}.card-copy text{display:block;overflow:hidden;text-overflow:ellipsis}.card-copy text:first-child{font-size:28rpx;font-weight:700;line-height:1.4;white-space:nowrap}.card-copy text:last-child{display:-webkit-box;min-height:58rpx;margin-top:8rpx;color:#858b88;font-size:20rpx;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}.empty{padding:150rpx 20rpx;text-align:center;color:#858d89;font-size:25rpx}
