.failure{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));background:#f4f7f5}.photo-wrap{position:relative;width:100%;height:360rpx;overflow:hidden;background:#dfe5e1;border-radius:8rpx}.submitted{width:100%;height:100%}.submitted-placeholder{display:flex;width:100%;height:100%;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;color:#7c8983;font-size:25rpx}.placeholder-icon{font-size:50rpx}.failure-badge{position:absolute;right:24rpx;bottom:22rpx;display:flex;width:68rpx;height:68rpx;align-items:center;justify-content:center;border:5rpx solid #fff;border-radius:50%;background:#b95047;color:#fff;box-shadow:0 4rpx 12rpx rgba(29,45,38,.18)}.failure-badge text{font-size:46rpx;line-height:1;transform:translateY(-2rpx)}.failure-summary{display:flex;flex-direction:column;align-items:center;padding:32rpx 16rpx 26rpx;text-align:center}.failure-title{font-size:36rpx;font-weight:700;color:#18231f}.failure-copy{max-width:600rpx;margin-top:14rpx;color:#66746e;font-size:25rpx;line-height:1.65}.commands{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx}.commands button{height:84rpx;margin:0;padding:0 10rpx;border-radius:6rpx;font-size:27rpx;line-height:84rpx}.commands .retry{background:#17664f;color:#fff}.commands .browse{border:1rpx solid #ccd6d1;background:#fff;color:#263a31}.recommend-header{display:flex;align-items:baseline;justify-content:space-between;margin:58rpx 2rpx 22rpx}.recommend-header text:first-child{font-size:34rpx;font-weight:700}.recommend-header text:last-child{color:#82908a;font-size:23rpx}.empty{padding:58rpx 0;text-align:center;color:#84918c;font-size:25rpx}.retry-load{color:#17664f}.loading-dot{display:inline-block;width:12rpx;height:12rpx;margin-right:12rpx;border-radius:50%;background:#31816a}.primary-result{overflow:hidden;background:#fff;border:1rpx solid #e0e7e3;border-radius:7rpx}.primary-result image{display:block;width:100%;height:350rpx}.primary-meta{display:flex;align-items:center;justify-content:space-between;padding:22rpx 24rpx}.primary-meta text:first-child{max-width:470rpx;font-size:31rpx;font-weight:600;overflow-wrap:break-word}.primary-meta text:last-child{color:#587168;font-size:23rpx}.similar-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx;margin-top:20rpx}.similar-item{min-width:0;overflow:hidden;background:#fff;border:1rpx solid #e0e7e3;border-radius:7rpx}.similar-item image{display:block;width:100%;height:190rpx}.similar-item view{padding:17rpx 18rpx}.similar-item text{display:block;overflow-wrap:break-word}.similar-item text:first-child{min-height:72rpx;font-size:27rpx;font-weight:600;line-height:1.4}.similar-item text:last-child{margin-top:8rpx;color:#6c7c75;font-size:22rpx}
