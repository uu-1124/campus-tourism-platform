.success-page{min-height:100vh;box-sizing:border-box;padding:24rpx 20rpx calc(48rpx + env(safe-area-inset-bottom));background:#f7f7f9;color:#1f2422}.success-banner{display:flex;align-items:center;height:72rpx;padding:0 30rpx;background:#fff;color:#58a577;font-size:27rpx}.check{display:flex;width:31rpx;height:31rpx;align-items:center;justify-content:center;margin-right:16rpx;border-radius:5rpx;background:#54c887;color:#fff;font-size:23rpx}.recognized-image{display:block;width:100%;height:480rpx;background:#e3e8e5}.building-summary{margin:24rpx 22rpx 0;padding:28rpx 30rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(39,48,44,.07)}.building-name,.building-english{display:block}.building-name{font-size:39rpx;font-weight:700;line-height:1.35;overflow-wrap:break-word}.building-english{margin-top:10rpx;color:#8d9390;font-size:24rpx;line-height:1.45}.detail-button{width:390rpx;height:88rpx;margin:34rpx auto 26rpx;border-radius:44rpx;background:#d8ad53;color:#fff;font-size:29rpx;font-weight:600;line-height:88rpx}.success-actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.success-actions button{height:88rpx;margin:0;border:0;background:#fff;color:#525b57;font-size:26rpx;line-height:88rpx}.success-actions button+button{border-left:1rpx solid #edf0ee}.success-actions text{margin-right:9rpx;color:#6f7773}.status-message{padding:180rpx 30rpx;text-align:center;color:#68746f;font-size:27rpx}.status-message.error{color:#b05249}
