page { background: #f4f7f5; color: #17221f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button::after { border: 0; }
.page { min-height: 100vh; }
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 30rpx 20rpx; }
.section-title text:first-child { font-size: 36rpx; font-weight: 700; }
.section-title text:last-child { color: #73817c; font-size: 24rpx; }
.empty { padding: 70rpx 0; text-align: center; color: #8c9894; }
